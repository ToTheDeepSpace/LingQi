.home-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 30rpx;
}

.home-entry {
  min-height: 168rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border: 1rpx solid rgba(217, 168, 87, 0.24);
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(31, 41, 55, 0.05);
}

.home-entry-title {
  color: #275389;
  font-size: 30rpx;
  font-weight: 900;
}

.home-entry-meta {
  margin-top: 12rpx;
  color: rgba(71, 85, 105, 0.72);
  font-size: 24rpx;
  line-height: 1.5;
}
