<view class="page">
  <view class="hero compact">
    <view class="eyebrow">口碑事件榜</view>
    <view class="title">红黑白榜</view>
    <view class="subtitle">红榜夸好体验，黑榜记录风险，白榜收纳笑话和中性故事。</view>
  </view>

  <view class="filter-row">
    <view class="filter {{type === 'all' ? 'active' : ''}}" data-type="all" bindtap="setType">全部</view>
    <view class="filter {{type === 'red' ? 'active' : ''}}" data-type="red" bindtap="setType">红榜</view>
    <view class="filter {{type === 'white' ? 'active' : ''}}" data-type="white" bindtap="setType">白榜</view>
    <view class="filter {{type === 'black' ? 'active' : ''}}" data-type="black" bindtap="setType">黑榜</view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:elif="{{error}}" class="empty">{{error}}</view>
  <view wx:elif="{{items.length === 0}}" class="empty">暂无公开口碑</view>

  <block wx:for="{{items}}" wx:key="id">
    <view class="card ranking-card">
      <view class="ranking-top">
        <view class="ranking-type {{item.type}}">{{typeText[item.type] || item.type}}</view>
        <view class="meta">{{item.subject_city || '未知城市'}} · {{item.subject_type || '对象'}}</view>
      </view>
      <view class="card-title">{{item.subject_name}}</view>
      <view class="content">{{item.content}}</view>
      <view class="pill-row">
        <view class="pill">打榜 {{item.boost_amount || item.initial_amount || 0}}</view>
        <view class="pill">踩榜 {{item.negative_boost_amount || 0}}</view>
        <view class="pill">评论 {{item.comment_count || 0}}</view>
      </view>
    </view>
  </block>
</view>
