# 剧幕录 - 环境变量配置
# 复制此文件为 .env 并填入你的实际值

# Supabase
VITE_SUPABASE_URL=https://sntrybbtdkifgjfjgmuw.supabase.co
VITE_SUPABASE_ANON_KEY=你的_anon_key

# 后端（腾讯云服务 / 本地 .env）
SUPABASE_SERVICE_ROLE_KEY=你的_service_role_key
JWT_SECRET=随机生成的密钥字符串
ADMIN_PASSWORD=你的管理员密码
SUPABASE_PAT=你的_personal_access_token_可选

# 手机短信验证码（腾讯云短信，生产环境必填）
AUTH_CODE_PEPPER=随机生成的验证码哈希盐
SMS_CODE_TTL_MINUTES=5
SMS_CODE_COOLDOWN_SECONDS=60
TENCENTCLOUD_SECRET_ID=你的腾讯云SecretId
TENCENTCLOUD_SECRET_KEY=你的腾讯云SecretKey
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_SDK_APP_ID=短信应用SdkAppId
TENCENT_SMS_SIGN_NAME=已审核通过的短信签名内容
TENCENT_SMS_TEMPLATE_ID=已审核通过的验证码模板ID

# 微信开放平台网站应用扫码登录
LINGQI_SITE_URL=https://jumulu.jusichen.com
WECHAT_OPEN_APP_ID=微信开放平台网站应用AppID
WECHAT_OPEN_APP_SECRET=微信开放平台网站应用AppSecret
WECHAT_REDIRECT_URI=https://jumulu.jusichen.com/api/lc/auth/wechat/callback

# 微信小程序消息推送服务器配置
WECHAT_MP_TOKEN=微信小程序消息推送Token_3到32位英文数字
WECHAT_MP_ENCODING_AES_KEY=微信小程序消息加密密钥_43位

# 支付宝电脑网站支付（剧幕录钱包自动充值）
ALIPAY_APP_ID=支付宝开放平台应用AppID
ALIPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n你的应用私钥\n-----END PRIVATE KEY-----"
ALIPAY_PRIVATE_KEY_FILE=可选_服务器私钥文件路径
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n支付宝公钥\n-----END PUBLIC KEY-----"
ALIPAY_PUBLIC_KEY_FILE=可选_服务器支付宝公钥文件路径
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://jumulu.jusichen.com/api/lc/wallet/alipay/notify
ALIPAY_RETURN_URL=https://jumulu.jusichen.com/wallet?alipay=return
ALIPAY_SELLER_ID=可选_支付宝卖家ID
PAYMENT_ORDER_TTL_MINUTES=30

# 微信支付 Native 扫码支付
WECHAT_PAY_APP_ID=微信支付绑定的公众号/小程序/开放平台AppID
WECHAT_PAY_MCH_ID=微信支付商户号
WECHAT_PAY_MCH_SERIAL_NO=商户API证书序列号
WECHAT_PAY_API_V3_KEY=32字节APIv3密钥
WECHAT_PAY_API_V3_KEY_FILE=可选_服务器APIv3密钥文件路径
WECHAT_PAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n你的商户API私钥apiclient_key.pem\n-----END PRIVATE KEY-----"
WECHAT_PAY_PRIVATE_KEY_FILE=可选_服务器商户API私钥文件路径
WECHAT_PAY_PUBLIC_KEY_ID=微信支付公钥ID_PUB_KEY_ID开头
WECHAT_PAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n你的微信支付公钥\n-----END PUBLIC KEY-----"
WECHAT_PAY_PUBLIC_KEY_FILE=可选_服务器微信支付公钥文件路径
WECHAT_PAY_GATEWAY=https://api.mch.weixin.qq.com
WECHAT_PAY_NOTIFY_URL=https://jumulu.jusichen.com/api/lc/wallet/wechat/notify
