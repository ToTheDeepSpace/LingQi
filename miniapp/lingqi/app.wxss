page {
  min-height: 100%;
  background: #fffdf8;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 64rpx;
}

.hero {
  border: 1rpx solid rgba(217, 168, 87, 0.24);
  border-radius: 20rpx;
  padding: 28rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fff7e7 100%);
  box-shadow: 0 18rpx 48rpx rgba(31, 41, 55, 0.06);
}

.eyebrow {
  color: #a66a1f;
  font-size: 24rpx;
  font-weight: 800;
}

.title {
  margin-top: 10rpx;
  color: #1f2937;
  font-size: 42rpx;
  line-height: 1.18;
  font-weight: 900;
}

.subtitle {
  margin-top: 14rpx;
  color: rgba(71, 85, 105, 0.78);
  font-size: 27rpx;
  line-height: 1.65;
}

.section-title {
  margin: 36rpx 0 18rpx;
  font-size: 30rpx;
  font-weight: 900;
  color: #1f2937;
}

.card {
  margin-bottom: 18rpx;
  border: 1rpx solid rgba(217, 168, 87, 0.2);
  border-radius: 18rpx;
  padding: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(31, 41, 55, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #275389;
}

.meta {
  margin-top: 8rpx;
  color: rgba(71, 85, 105, 0.72);
  font-size: 24rpx;
  line-height: 1.55;
}

.content {
  margin-top: 14rpx;
  color: #334155;
  font-size: 27rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(217, 168, 87, 0.12);
  color: #925f18;
  font-size: 23rpx;
  font-weight: 800;
}

.button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #d9a857, #c9922e);
  color: #fffdf8;
  font-size: 28rpx;
  font-weight: 900;
}

.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  border: 1rpx solid rgba(217, 168, 87, 0.35);
  border-radius: 16rpx;
  background: #ffffff;
  color: #925f18;
  font-size: 28rpx;
  font-weight: 900;
}

.empty {
  padding: 48rpx 24rpx;
  border: 1rpx dashed rgba(148, 163, 184, 0.4);
  border-radius: 18rpx;
  color: #64748b;
  text-align: center;
  font-size: 26rpx;
}

.input {
  width: 100%;
  box-sizing: border-box;
  min-height: 82rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(201, 146, 46, 0.28);
  border-radius: 16rpx;
  background: #ffffff;
  color: #1f2937;
  font-size: 28rpx;
}
