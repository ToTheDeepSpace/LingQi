[Unit]
Description=Sign and externally anchor the latest completed Jumulu audit root
Wants=network-online.target postgresql.service
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/srv/ops/jumulu-audit-anchor/anchor-daily-root.sh
UMask=0077
Nice=10
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/jumulu-audit-anchor
NoNewPrivileges=true

